# Production origin, no trailing slash. Enables canonical URLs, the sitemap host,
# indexing and structured data. Leave unset for local and preview builds (they ask crawlers to stay out).
NEXT_PUBLIC_SITE_URL=

# Optional: ownership tokens for Google Search Console and Bing Webmaster Tools.
# Paste only the token (the content="..." value of the meta tag they give you), then redeploy.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: server-side contact form delivery through Resend (https://resend.com).
# With all three set, the form posts to /api/contact. Without them it opens the visitor's email app.
# These are read on the server only. Never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Password for the site panel at /admin. At least 8 characters; the panel is on the live
# site too, so use a long random one there. Put the real value in .env.local, which is never committed.
ADMIN_PASSWORD=

# Supabase holds what the panel saves (table site_store) and uploads (bucket "media").
# The service role key is read on the server and at build time only. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Deploy Hook (Project Settings > Git > Deploy Hooks). Each save in the panel calls it,
# so the live site rebuilds with the new content. Set it in Vercel only, not in .env.local.
VERCEL_DEPLOY_HOOK_URL=
